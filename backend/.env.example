# Proveedor de LLM: mock (predeterminado offline sin coste), gemini, openai
LLM_PROVIDER=mock

# Clave API para Google Gemini (si LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Clave API para OpenAI (si LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Directorio de persistencia para ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Orígenes CORS permitidos
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
